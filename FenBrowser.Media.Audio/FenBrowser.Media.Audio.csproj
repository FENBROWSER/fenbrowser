<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform audio outputs behind IAudioOutput (ADR-0003). Windows: WASAPI shared mode,
       event driven. Other platforms fall back to the null sink until their backends land. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FenBrowser.Media\FenBrowser.Media.csproj" />
  </ItemGroup>
</Project>
