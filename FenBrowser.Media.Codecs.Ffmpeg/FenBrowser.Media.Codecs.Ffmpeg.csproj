<Project Sdk="Microsoft.NET.Sdk">
  <!-- The libavcodec adapter of ADR-0001: a minimal P/Invoke layer we own. The library is
       loaded dynamically (LGPL), pinned to one major version, and registers nothing when
       it is missing or the wrong version. Only FenBrowser.Media is referenced. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FenBrowser.Media\FenBrowser.Media.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FenBrowser.Media.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
