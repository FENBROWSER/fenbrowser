<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <IsPackable>false</IsPackable>
    <RestoreUseStaticGraphEvaluation>false</RestoreUseStaticGraphEvaluation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.148.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.7" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestData\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FenBrowser.Core\FenBrowser.Core.csproj" />
    <ProjectReference Include="..\FenBrowser.FenEngine\FenBrowser.FenEngine.csproj" />
    <ProjectReference Include="..\FenBrowser.Conformance\FenBrowser.Conformance.csproj" />
    <ProjectReference Include="..\FenBrowser.DevTools\FenBrowser.DevTools.csproj" />
    <ProjectReference Include="..\FenBrowser.Host\FenBrowser.Host.csproj" />
    <ProjectReference Include="..\FenBrowser.Tooling\FenBrowser.Tooling.csproj" />
    <ProjectReference Include="..\FenBrowser.Wasm\FenBrowser.Wasm.csproj" />
  </ItemGroup>

  <!-- Legacy-engine-dependent tests excluded pending FenJS migration -->
  <ItemGroup>
    <Compile Remove="Engine\**\*.cs" />
    <Compile Remove="DOM\**\*.cs" />
    <Compile Remove="WebAPIs\**\*.cs" />
    <Compile Remove="Workers\**\*.cs" />
    <Compile Remove="Interaction\**\*.cs" />
    <Compile Remove="Integration\**\*.cs" />
    <Compile Remove="Core\ConsoleApiTests.cs" />
    <Compile Remove="Core\SymbolTests.cs" />
    <Compile Remove="Diagnostics\**\*.cs" />
    <Compile Remove="Host\**\*.cs" />
    <Compile Remove="Testing\**\*.cs" />
    <Compile Remove="Rendering\**\*.cs" />
    <Compile Remove="DevTools\**\*.cs" />
    <Compile Remove="Architecture\**\*.cs" />
    <Compile Remove="Core\ControlFlowInvariantTests.cs" />
    <Compile Remove="Core\EventInvariantTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Current FenJS/event-loop diagnostic regression; keep this explicit so the
         broader legacy Engine tree remains excluded. -->
    <Compile Include="Engine\EventLoopTraceTests.cs" />
    <Compile Include="Engine\EventLoopRenderOrderingTests.cs" />
    <!-- MessageRouter dispatch concurrency tests; the rest of the DevTools tree
         stays excluded pending review. -->
    <Compile Include="DevTools\MessageRouterTests.cs" />
    <!-- Active renderer-child stdin polling contract; keep Architecture legacy
         and policy tests excluded until they are reviewed independently. -->
    <Compile Include="Architecture\RendererChildLoopIoTests.cs" />
    <!-- Phase 1 animation-scoping regression (BrowserIntegration is in Host,
         which is otherwise excluded). -->
    <Compile Include="Host\Phase1AnimationScopingTests.cs" />
    <!-- Phase 2 animation single-flight coalescing regression. -->
    <Compile Include="Host\Phase2AnimationCoalescingTests.cs" />
    <!-- Phase 5/6 scoped image repaint/relayout callback regression. -->
    <Compile Include="Rendering\Phase5ImageScopingTests.cs" />
    <Compile Include="Rendering\BrowserEngineTests.cs" />
    <!-- Phase 9 verification/screenshot gating regression. -->
    <Compile Include="Host\Phase9VerificationGatingTests.cs" />
    <!-- Phase 14 bounded/coalesced frame-request regression. -->
    <Compile Include="Host\Phase14FrameRequestCoalescingTests.cs" />
    <!-- Phase 11 interaction re-cascade CancellationTokenSource ownership. -->
    <Compile Include="Host\Phase11InteractionRecascadeCtsTests.cs" />
    <!-- Phase 10 watchdog late-frame policy regression. -->
    <Compile Include="Rendering\Phase10WatchdogLateFramePolicyTests.cs" />
    <Compile Include="Rendering\HitTesterContractTests.cs" />
    <Compile Include="Rendering\BorderCurrentColorContractTests.cs" />
    <Compile Include="Rendering\PageFeedbackContractTests.cs" />
    <!-- Phase 3 property-specific animation invalidation classification. -->
    <Compile Include="Rendering\Phase3AnimationClassificationTests.cs" />
    <!-- Phase 17 final multi-tab performance/isolation regression suite. -->
    <Compile Include="Host\Phase17MultiTabPerformanceTests.cs" />
    <Compile Include="Host\TabWidgetRenderingTests.cs" />
    <!-- window.open URL-popup loading/error-page mapping regression. -->
    <Compile Include="Host\PopupUrlContentTests.cs" />
    <!-- Phase 15 no-op full-document work elimination regression. -->
    <Compile Include="Rendering\Phase15NoOpWorkEliminationTests.cs" />
    <!-- Phase 6 image-loader repaint coalescing and disposal regression. -->
    <Compile Include="Rendering\Phase6ImageRepaintCoalescingTests.cs" />
    <!-- Phase 4 compositor-only fast-path and rebuild telemetry regression. -->
    <Compile Include="Rendering\Phase4CompositorOnlyPathTests.cs" />
    <!-- Phase 13 end-to-end pipeline animation tests (real renderer verification). -->
    <Compile Include="Rendering\PipelineAnimationTests.cs" />
    <Compile Include="Rendering\BaseFrameReusePolicyTests.cs" />
    <Compile Include="Rendering\PaintTreeScrollIntegrationTests.cs" />
    <!-- Phase 12 async input dispatch non-blocking regression. -->
    <Compile Include="Engine\Phase12AsyncInputDispatchTests.cs" />
    <Compile Include="Engine\CustomHtmlEngineFallbackPromotionTests.cs" />
    <Compile Include="Engine\CustomHtmlEngineNoJsNormalizationTests.cs" />
    <Compile Include="Engine\MediaWikiDeduplicatedInlineStyleTests.cs" />
    <!-- Google /sorry CAPTCHA page layout regression (br before block with
         atomic replaced element collapses the form subtree). -->
    <Compile Include="Engine\GoogleSorryPageLayoutRegressionTests.cs" />
    <Compile Include="Engine\BrIsolationTests.cs" />
    <!-- PII-safe cookie diagnostics regression; NavigationGlobalsProbeTests stays
         excluded because the production probe type was removed. -->
    <Compile Include="Diagnostics\CookieDiagnosticsTests.cs" />
  </ItemGroup>

</Project>
