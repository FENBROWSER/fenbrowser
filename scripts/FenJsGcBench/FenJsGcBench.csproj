<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deterministic FenJS worker-turn benchmark (MessagePort delivery shape:
       handler + promise/microtask chain + array map with closures + GC churn).
       Not part of the solution; build and run directly via dotnet run. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FenBrowser.Js\FenBrowser.Js.csproj" />
  </ItemGroup>

</Project>
