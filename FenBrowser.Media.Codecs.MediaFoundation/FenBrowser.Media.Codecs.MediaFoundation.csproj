<Project Sdk="Microsoft.NET.Sdk">
  <!-- The OS decoders of ADR-0002 on Windows: the Media Foundation AAC and H.264 (and, when
       the HEVC extension is installed, HEVC) transforms behind IMediaDecoder, reached through
       a hand-declared slice of the Media Foundation COM surface. Registers nothing on other
       platforms or when a transform cannot be created. Only FenBrowser.Media is referenced. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FenBrowser.Media\FenBrowser.Media.csproj" />
    <ProjectReference Include="..\FenBrowser.Media.Gpu\FenBrowser.Media.Gpu.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FenBrowser.Media.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
