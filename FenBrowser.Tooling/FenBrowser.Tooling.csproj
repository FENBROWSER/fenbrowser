<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <!--
      The same collector as FenBrowser.Host. debug-site and the other commands run the
      browser engine in this process, and under the default workstation collector a
      YouTube load spent most of its script-thread samples waiting for collections the
      Host never sees, so timings taken here did not describe the browser.
    -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FenBrowser.Core\FenBrowser.Core.csproj" />
    <ProjectReference Include="..\FenBrowser.FenEngine\FenBrowser.FenEngine.csproj" />
    <ProjectReference Include="..\FenBrowser.Host\FenBrowser.Host.csproj" />
    <ProjectReference Include="..\FenBrowser.WebDriver\FenBrowser.WebDriver.csproj" />
  </ItemGroup>

  <!-- Legacy-test includes removed along with the legacy JS engine -->
  <ItemGroup>
    <Compile Remove="MultiTabHeadlessRunner.cs" />
    <Compile Remove="Test262ToolRunner.cs" />
  </ItemGroup>

</Project>
