<Project>
  <PropertyGroup>
    <!-- Work around intermittent restore graph failures that return 0 warnings/0 errors on this machine. -->
    <RestoreUseStaticGraphEvaluation>false</RestoreUseStaticGraphEvaluation>
    <RestoreUseSkipNonexistentTargets>false</RestoreUseSkipNonexistentTargets>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <!-- Required for actions/setup-dotnet cache: true. Generates packages.lock.json per project. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
