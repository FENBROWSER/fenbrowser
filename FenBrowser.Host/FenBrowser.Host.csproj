<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>FenBrowser.Host</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);NU1605</NoWarn>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>0.1.0-alpha</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Company>FenBrowser</Company>
    <Product>FenBrowser</Product>
    <Authors>FenBrowser</Authors>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FenBrowser.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FenBrowser.Core\FenBrowser.Core.csproj" />
    <ProjectReference Include="..\FenBrowser.FenEngine\FenBrowser.FenEngine.csproj" />
    <ProjectReference Include="..\FenBrowser.DevTools\FenBrowser.DevTools.csproj" />
    <ProjectReference Include="..\FenBrowser.WebDriver\FenBrowser.WebDriver.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- BrowserApi-dependent files excluded pending FenJS migration -->
  <ItemGroup>
    <Compile Remove="BrowserIntegration.cs" />
    <Compile Remove="ChromeManager.cs" />
    <Compile Remove="DevToolsHostAdapter.cs" />
    <Compile Remove="WebDriver\FenBrowserDriver.cs" />
    <Compile Remove="WebDriver\HostBrowserDriver.cs" />
    <Compile Remove="Tabs\BrowserTab.cs" />
    <Compile Remove="Tabs\TabManager.cs" />
    <Compile Remove="ProcessIsolation\BrokeredProcessIsolationCoordinator.cs" />
    <Compile Remove="ProcessIsolation\IProcessIsolationCoordinator.cs" />
    <Compile Remove="ProcessIsolation\InProcessIsolationCoordinator.cs" />
    <Compile Remove="Widgets\**\*.cs" />
    <Compile Remove="ProcessIsolation\ProcessIsolationCoordinatorFactory.cs" />
    <Compile Remove="ProcessIsolation\ProcessIsolationRuntime.cs" />
    <Compile Remove="RootWidget.cs" />
    <Compile Remove="ProcessIsolation\Gpu\GpuCompositorWorkSubmitter.cs" />
    <Compile Remove="CompositorThread.cs" />
    <Compile Remove="Compositor.cs" />
    <Compile Remove="Input\**\*.cs" />
    <Compile Remove="WindowManager.cs" />
    <Compile Remove="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGLES" Version="2.21.0" />
    <PackageReference Include="Silk.NET.OpenGLES.ANGLE.Native" Version="2025.9.12" />
    <PackageReference Include="Silk.NET.OpenGLES.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.21.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.21.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" />
    <PackageReference Include="Topten.RichTextKit" Version="0.4.164" />
  </ItemGroup>

  <Target Name="CleanupLogs" BeforeTargets="Build">
    <Exec Command="if exist &quot;$(MSBuildProjectDirectory)\..\cleanup_logs.bat&quot; call &quot;$(MSBuildProjectDirectory)\..\cleanup_logs.bat&quot;" IgnoreExitCode="true" />
  </Target>

  <Target Name="BumpMainThreadStack" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <ExePath>$(TargetDir)$(AssemblyName).exe</ExePath>
    </PropertyGroup>
    <Exec
      Command="for /f &quot;tokens=*&quot; %25%25i in ('&quot;%25ProgramFiles(x86)%25\Microsoft Visual Studio\Installer\vswhere.exe&quot; -latest -find VC\Tools\MSVC\*\bin\Hostx64\x64\editbin.exe ^| findstr /v /i preview') do (&quot;%25%25i&quot; /STACK:16777216 &quot;$(ExePath)&quot; &gt;nul 2&gt;&amp;1 &amp;&amp; goto :done) %26 :done"
      IgnoreExitCode="true"
      Condition="Exists('$(ExePath)')" />
  </Target>

</Project>
