<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>FenBrowser.Host</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);NU1605</NoWarn>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>0.1.0-alpha</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Company>FenBrowser</Company>
    <Product>FenBrowser</Product>
    <Authors>FenBrowser</Authors>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FenBrowser.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FenBrowser.Core\FenBrowser.Core.csproj" />
    <ProjectReference Include="..\FenBrowser.FenEngine\FenBrowser.FenEngine.csproj" />
    <ProjectReference Include="..\FenBrowser.DevTools\FenBrowser.DevTools.csproj" />
    <ProjectReference Include="..\FenBrowser.WebDriver\FenBrowser.WebDriver.csproj" />
    <ProjectReference Include="..\FenBrowser.DependencyInjection\FenBrowser.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGLES" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGLES.ANGLE.Native" Version="2025.9.12" />
    <PackageReference Include="Silk.NET.OpenGLES.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="SkiaSharp" Version="4.148.0" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.148.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.148.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.148.0" Condition="'$(OS)' == 'Linux'" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.148.0" Condition="'$(OS)' == 'Unix' And '$(OS)' != 'Linux'" />
    <PackageReference Include="Topten.RichTextKit" Version="0.4.167" />
  </ItemGroup>

  <Target Name="CleanupLogs" BeforeTargets="Build">
    <Exec Command="if exist &quot;$(MSBuildProjectDirectory)\..\cleanup_logs.bat&quot; call &quot;$(MSBuildProjectDirectory)\..\cleanup_logs.bat&quot;" IgnoreExitCode="true" />
  </Target>

  <Target Name="BumpMainThreadStack" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <ExePath>$(TargetDir)$(AssemblyName).exe</ExePath>
    </PropertyGroup>
    <Exec Command="for /f &quot;tokens=*&quot; %25%25i in ('&quot;%25ProgramFiles(x86)%25\Microsoft Visual Studio\Installer\vswhere.exe&quot; -latest -find VC\Tools\MSVC\*\bin\Hostx64\x64\editbin.exe ^| findstr /v /i preview') do (&quot;%25%25i&quot; /STACK:16777216 &quot;$(ExePath)&quot; &gt;nul 2&gt;&amp;1 &amp;&amp; goto :done) %26 :done" IgnoreExitCode="true" Condition="Exists('$(ExePath)')" />
  </Target>

</Project>
