<Project Sdk="Microsoft.NET.Sdk">

  <!-- ── WebIDL Binding Generation ─────────────────────────────────────────
  Runs webidlgen before each build to (re)generate C# binding stubs from
  the canonical *.idl source files in FenBrowser.Core/WebIDL/Idl/.
  Generated files land in Bindings/Generated/ and are compiled as normal
  C# source. The <None> items expose the IDL files to VS tooling.
  Using optimized build infrastructure with dependency tracking.
  ───────────────────────────────────────────────────────────────────── -->
  
  <!-- Import WebIDL build infrastructure (Option D: Pipeline Improvement) -->
  <Import Project="$(MSBuildThisFileDirectory)Build\WebIdl.Build.props" />
  
  <ItemGroup>
    <None Include="..\FenBrowser.Core\WebIDL\Idl\*.idl" />
  </ItemGroup>
  
  <!-- Enhanced Project References with proper build ordering -->
  <ItemGroup>
    <ProjectReference Include="..\FenBrowser.Core\FenBrowser.Core.csproj" />
    <ProjectReference Include="..\FenBrowser.WebIdlGen\FenBrowser.WebIdlGen.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <!-- Ensures build order: WebIdlGen builds before projects that need bindings -->
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <BuildReference Condition="'$(DesignTimeBuild)' != 'true'">true</BuildReference>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Program.cs" />
    <Compile Remove="TestFenEngine.cs" />
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="HTML\**\*.cs" />
    <Compile Remove="Testing\**\*.cs" />
    <Compile Remove="WebAPIs\TestHarnessAPI.cs" />
    <Compile Remove="WebAPIs\TestConsoleCapture.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FenBrowser.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FenBrowser.Tooling</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.2" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="2.88.9" />
    <PackageReference Include="Svg.Skia" Version="3.2.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
